rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /players/{userId} {
      function owner() { return request.auth != null && request.auth.uid == userId; }
      function oldRecords() { return resource.data.get('economyRecords', {}); }
      function newRecords() { return request.resource.data.get('economyRecords', {}); }
      function changes() { return request.resource.data.get('recordChanges', []); }
      function validRecord(r) {
        return r.keys().hasOnly(['type','coins','xp','item','sphere','locked','completed','progress','claims','offset','weekdays','active','createdDay'])
          && r.keys().hasAll(['type','coins','xp','item','sphere','locked','completed','progress','claims','offset','weekdays','active','createdDay'])
          && r.type in ['quest','habit','stage'] && r.coins is int && r.coins >= 0
          && r.xp is int && (r.type == 'stage' ? r.xp >= 0 && r.xp <= 500 : r.xp in [5,10,20,35,50])
          && r.item in ['', 'plant_basic','book_basic','cup_basic','crown_basic','key_basic','medal_basic']
          && r.sphere in ['health','sport','growth','english','finance','together','driving','tasks','hobby']
          && r.locked is bool && r.completed is bool && r.active is bool
          && r.progress is number && r.progress >= 0 && (r.progress == 0 || r.locked) && r.claims is map
          && r.offset is int && r.offset >= -720 && r.offset <= 840
          && r.createdDay is int && r.createdDay >= 0
          && r.weekdays is list && r.weekdays.toSet().size() == r.weekdays.size()
          && r.weekdays.hasOnly([0,1,2,3,4,5,6])
          && (r.type == 'stage' ? r.coins <= 500 && r.item == '' && r.claims.size() == 0 && r.weekdays.size() == 0 && r.offset == 0 && r.createdDay == 0 && r.progress == 0 && (!r.completed || r.locked) : r.type == 'quest'
            ? (r.coins <= 100 && r.claims.size() == 0 && r.weekdays.size() == 0 && r.offset == 0 && r.createdDay == 0 && (!r.completed || r.locked))
            : (r.coins <= 10 && r.xp == 5 && r.item == '' && !r.completed && r.progress == 0 && r.weekdays.size() > 0 && (r.claims.size() == 0 || r.locked)));
      }
      function validHabitClaims(old, next, day) {
        let added = next.claims.diff(old.claims).affectedKeys();
        return next.claims.keys().hasAll(old.claims.keys())
          && next.claims.diff(old.claims).changedKeys().size() == 0
          && added.size() <= 1
          && (added.size() == 0 || (added.hasOnly([day]) && next.active && next.claims[day] == true
            && day == string(int(day)) && int(day) >= next.createdDay
            && int(day) <= int((request.time.toMillis() + next.offset * 60000) / 86400000)
            && next.weekdays.hasAny([(int(day) + 4) % 7])));
      }
      function questXp(d) {
        return d == 'Micro' ? 5 : d == 'Simple' ? 10 : d == 'Medium' ? 20 : d == 'Hard' ? 35 : d == 'Very Hard' ? 50 : -1;
      }
      function receipt(r, p, claimId, sourceId, kind) {
        let ledger = request.resource.data.state.get('coinTransactions', []);
        let t = p.receiptIndex >= 0 && p.receiptIndex < ledger.size() ? ledger[p.receiptIndex] : {};
        return t.size() > 0 && t.transactionId == claimId && t.userId == userId
          && t.sourceId == sourceId && t.amount == r.coins && t.type == kind;
      }
      function questProof(id, r, p) {
        let qs = request.resource.data.state.quests;
        let q = p.sourceIndex >= 0 && p.sourceIndex < qs.size() ? qs[p.sourceIndex] : {};
        return q.size() > 0 && id == 'quest:' + q.id && q.get('ownerId', userId) == userId
          && q.done && q.rewardClaimed && q.completedAt is string && q.rewardClaimedAt is string
          && q.sphere == r.sphere && q.xp == r.xp
          && (q.get('sourceType','SYSTEM') != 'USER_CREATED' || q.xp == questXp(q.difficulty)) && q.get('virtualRewardId','') == r.item
          && r.coins == (q.get('sourceType','SYSTEM') == 'USER_CREATED' ? q.rewardCoins : int((q.xp + 4) / 5))
          && receipt(r,p,id,q.id,'QUEST_REWARD');
      }
      function habitProof(id, r, p, day) {
        let hs = request.resource.data.state.get('habits', []);
        let cs = request.resource.data.state.get('habitCompletions', []);
        let h = p.sourceIndex >= 0 && p.sourceIndex < hs.size() ? hs[p.sourceIndex] : {};
        let c = p.completionIndex >= 0 && p.completionIndex < cs.size() ? cs[p.completionIndex] : {};
        return h.size() > 0 && c.size() > 0 && id == 'habit:' + h.id && h.ownerId == userId
          && h.sphere == r.sphere && h.rewardCoins == r.coins && h.rewardXp == 5
          && h.isActive && h.rewardLocked && h.weekdays == r.weekdays && h.timezoneMinutes == r.offset
          && c.value == h.targetValue && c.habitId == h.id && c.ownerId == userId && c.dayOrdinal == int(day) && c.rewardClaimed
          && c.id == 'habit:' + h.id + ':' + c.day && c.rewardClaimedAt is string
          && receipt(r,p,c.id,h.id,'HABIT_REWARD');
      }
      function stageProof(id,r,p) {
        let goals=request.resource.data.state.goals;
        let g=goals[p.goalIndex];
        let stage=g.stages[p.stageIndex];
        return id == 'stage:' + g.id + ':' + stage.id && stage.rewardClaimed && stage.status == 'completed'
          && stage.completedAt is string && stage.get('rewardXP',0) == r.xp && stage.get('rewardCoins',0) == r.coins && g.sphere == r.sphere;
      }
      function reversal(id,old,next) {
        let p=request.resource.data.get('rewardProofs',{}).get(id,{});
        let before=resource.data.state.quests[p.oldSourceIndex];
        let q=request.resource.data.state.quests[p.sourceIndex];
        return old.type == 'quest' && old.completed && !next.completed && next.locked
          && next.diff(old).affectedKeys().hasOnly(['completed','progress']) && next.progress == 0
          && id == 'quest:' + before.id && q.id == before.id && before.get('goalId','') != '' && q.goalId == before.goalId
          && before.done && !q.done && !q.rewardClaimed && q.xp == old.xp && q.sphere == old.sphere
          && request.resource.data.state.xp <= resource.data.state.xp-old.xp
          && request.resource.data.state.spheres[old.sphere].xp <= resource.data.state.spheres[old.sphere].xp-old.xp;
      }
      function validProof(id, old, next) {
        let days = next.claims.diff(old.claims).addedKeys();
        let paid = next.type != 'habit' ? !old.completed && next.completed : days.size() > 0;
        let proofs = request.resource.data.get('rewardProofs', {});
        return !paid || (next.coins == old.coins && next.xp == old.xp && next.sphere == old.sphere && next.item == old.item && id in proofs && (next.type == 'quest'
          ? questProof(id,next,proofs[id]) : next.type == 'stage' ? stageProof(id,next,proofs[id]) : habitProof(id,next,proofs[id],proofs[id].claimDay)));
      }
      function habitReward(id, old, next) {
        let proof = request.resource.data.get('rewardProofs', {}).get(id, {});
        let day = proof.get('claimDay', '0');
        // The previously validated definition is immutable during a payout.
        // Revalidating every definition field here exceeds the expression budget.
        return old.type == 'habit'
          && next.diff(old).affectedKeys().hasOnly(['locked','claims','weekdays','active'])
          && next.locked && next.active
          && next.weekdays is list && next.weekdays.size() > 0
          && next.weekdays.hasOnly([0,1,2,3,4,5,6]) && next.weekdays.toSet().size() == next.weekdays.size()
          && validHabitClaims(old,next,day) && habitProof(id,next,proof,day);
      }
      function validChange(id, old, next) {
        return old.size() == 0 ? (validRecord(next) && next.claims.size() == 0)
          : (old.completed && !next.completed ? reversal(id,old,next) : next.type == 'habit' && next.claims.size() > old.claims.size()
            ? habitReward(id,old,next)
            : (validRecord(next) && next.type == old.type && next.createdDay == old.createdDay && next.offset == old.offset
              && (!old.locked || (next.locked && next.coins == old.coins && next.xp == old.xp && next.item == old.item && next.sphere == old.sphere))
              && (!old.completed || next.completed) && next.progress >= old.progress
              && (next.type == 'quest' || next.claims == old.claims) && validProof(id,old,next)));
      }
      function income(old, next) {
        return old.size() == 0 ? 0 : (next.type != 'habit'
          ? (!old.completed && next.completed ? old.coins : old.completed && !next.completed ? -old.coins : 0)
          : (next.claims.size() - old.claims.size()) * old.coins);
      }
      function economyValid() {
        let previous = oldRecords();
        let next = newRecords();
        let changed = changes();
        let id = changed.size() == 1 ? changed[0] : '';
        let prior = previous.get(id, {});
        let updated = next.get(id, {});
        return previous is map && next is map && changed is list
          && changed.size() <= 1
          && next.keys().hasAll(previous.keys())
          && next.diff(previous).affectedKeys() == changed.toSet()
          && (changed.size() == 0 || validChange(id,prior,updated))
          && request.resource.data.state.coins <= resource.data.state.coins + (changed.size() == 0 ? 0 : income(prior,updated));
      }
      function valid() {
        return request.resource.data.keys().hasOnly(['state','revision','updatedAt','economyRecords','recordChanges','rewardProofs'])
          && request.resource.data.keys().hasAll(['state','revision','updatedAt'])
          && request.resource.data.state is map
          && request.resource.data.state.profile.mode == 'personal'
          && request.resource.data.state.xp is int && request.resource.data.state.xp >= 0
          && request.resource.data.state.coins is int && request.resource.data.state.coins >= 0
          && request.resource.data.revision is int && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow list, delete: if false;
      allow create: if owner() && valid() && request.resource.data.revision == 1
        && request.resource.data.state.xp == 0 && request.resource.data.state.coins == 0
        && request.resource.data.get('economyRecords', {}).size() == 0
        && request.resource.data.get('recordChanges', []).size() == 0;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1 && economyValid();
    }
  }
}
