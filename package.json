{
  "name": "play-your-life",
  "private": true,
  "version": "0.40.6",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/build-city-models.mjs && node scripts/build-dark-theme.mjs && tsc -b && tsc -p integrations/ticktick/tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b && tsc -p integrations/ticktick/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm run build",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "city:models": "node scripts/build-city-models.mjs",
    "theme:dark": "node scripts/build-dark-theme.mjs",
    "test:quests-ui": "node tests/quests-ui.mjs",
    "test:tasks-calendar": "node tests/tasks-calendar-ui.mjs",
    "test:live-city": "node tests/live-city-ui.mjs",
    "test:goals-ui": "node tests/goals-ui.mjs",
    "test:theme-ui": "node tests/theme-ui.mjs",
    "test:spheres-ui": "node tests/spheres-ui.mjs",
    "test:key-results-ui": "node tests/key-results-ui.mjs",
    "test:month-report-ui": "node tests/month-report-ui.mjs",
    "test:smoke-ui": "node --experimental-strip-types --no-warnings tests/smoke-ui.mjs",
    "check:budgets": "node scripts/check-budgets.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/drei": "^10.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "@types/three": "^0.180.0",
    "playwright": "1.55.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  }
}
